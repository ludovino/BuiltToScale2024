code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_5;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


	vec2 n_out3p0;
// UVPolarCoord:3
	vec2 n_in3p1 = vec2(0.50000, 0.50000);
	float n_in3p2 = 1.00000;
	float n_in3p3 = 1.00000;
	{
		vec2 __dir = n_out4p0 - n_in3p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out3p0 = vec2(__radius * n_in3p2, __angle * n_in3p3);
	}


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);


	vec2 n_out10p0;
// UVPolarCoord:10
	vec2 n_in10p1 = vec2(0.50000, 0.50000);
	float n_in10p2 = 4.00000;
	float n_in10p3 = 1.00000;
	{
		vec2 __dir = n_out4p0 - n_in10p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out10p0 = vec2(__radius * n_in10p2, __angle * n_in10p3);
	}


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out10p0);


// VectorOp:7
	vec4 n_out7p0 = n_out2p0 * n_out5p0;
	float n_out7p4 = n_out7p0.a;


// Output:0
	ALPHA = n_out7p4;
	EMISSION = vec3(n_out7p0.xyz);


}
